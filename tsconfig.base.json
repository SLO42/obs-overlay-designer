{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": false,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@obs/core": ["packages/core/src/index.ts"],
      "@obs/core/*": ["packages/core/src/*"],
      "@obs/design-system": ["packages/design-system/src/index.ts"],
      "@obs/design-system/*": ["packages/design-system/src/*"],
      "@obs/widgets": ["packages/widgets/src/index.ts"],
      "@obs/widgets/*": ["packages/widgets/src/*"],
      "@obs/effects": ["packages/effects/src/index.ts"],
      "@obs/effects/*": ["packages/effects/src/*"],
      "@obs/twitch": ["packages/twitch/src/index.ts"],
      "@obs/twitch/*": ["packages/twitch/src/*"],
      "@obs/donations": ["packages/donations/src/index.ts"],
      "@obs/donations/*": ["packages/donations/src/*"],
      "@obs/overlay": ["apps/overlay/src/index.ts"],
      "@obs/overlay/*": ["apps/overlay/src/*"]
    }
  }
}
